    // `finally` block resets state and re-prompts, so nothing further is needed here.
    return;
  \}
  autoSaveOnExit\(\);
  console\.log\(theme\.accent\('\\nGoodbye!'\)\);
  process\.exit\(0\);
\}\);'''

new_pattern = r'''rl.on('SIGINT', () => {
  autoSaveOnExit();

  if (streaming && controller) {
    controller.abort();
    render?.cancelled() || process.stdout.write('\n');
    return;
  }
  console.log(theme.accent('\\nGoodbye!'));
  process.exit(0);
});'''

content = re.sub(old_pattern, new_pattern, content)

with open('src/index.ts', 'w') as f:
    f.write(content)

print("Fixed SIGINT handler")
ENDFIX
